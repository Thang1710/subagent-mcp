{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subagent-mcp.dev/adapter-v1.json",
  "title": "Subagent MCP adapter manifest v1",
  "type": "object",
  "required": [
    "adapter_api_version",
    "runtime_id",
    "provider_id",
    "harness_id",
    "display_name",
    "adapter_version",
    "supported_platforms",
    "supported_transports",
    "capabilities",
    "semantic_permissions",
    "reasoning_schema"
  ],
  "properties": {
    "adapter_api_version": {"const": "1.0.0"},
    "runtime_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "harness_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "supported_transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["visible-background", "managed-sdk", "native-acp"]}
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "semantic_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "reasoning_schema": {"type": "object"},
    "model_schema": {"type": "object"},
    "max_write_roots_per_session": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "default": 1
    }
  },
  "additionalProperties": true
}
