{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subagent-mcp.dev/agent-descriptor-v1.json",
  "title": "Subagent MCP normalized agent descriptor v1",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_id",
    "provider_id",
    "harness_id",
    "display_name",
    "model_display_name",
    "transport",
    "capability_gaps",
    "icon",
    "ui_surfaces"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "runtime_id": {"type": "string"},
    "provider_id": {"type": "string"},
    "harness_id": {"type": "string"},
    "display_name": {"type": "string"},
    "model_display_name": {"type": "string"},
    "transport": {"enum": ["visible-background", "managed-sdk", "native-acp"]},
    "capability_gaps": {"type": "array", "items": {"type": "string"}},
    "icon": {"type": "object"},
    "ui_surfaces": {
      "type": "object",
      "required": ["localhost_activity", "mcp_app", "native_host_panel"]
    }
  },
  "additionalProperties": true
}
